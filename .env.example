DATABASE_URL=postgres://localhost:5432/things
SESSION_SECRET=replace-me
SITE_PASSWORD=replace-me

# Shown on the signed-in user. Optional.
OWNER_EMAIL=

# Only used if Google sign-in is enabled. Leave both empty to allow any Google account.
